# =============================================================================
# home-bootstrap Environment Configuration
# =============================================================================
# Copy this file to .env and customize for your environment:
#   cp .env.example .env
#
# This file is loaded by the Makefile, bootstrap.sh, and test scripts.
# .env is gitignored — never commit your actual values.
# =============================================================================

# -- Domain Configuration ----------------------------------------------------
# Base domain for internal DNS (Proxmox hostnames, mail, etc.)
DOMAIN=lab.demena.net

# Ingress domain for k8s services (wildcard: *.INGRESS_DOMAIN)
# Used for Grafana, Jenkins, GitLab, Harbor, ArgoCD, etc.
INGRESS_DOMAIN=apps.lab.demena.net

# -- Proxmox Configuration ---------------------------------------------------
# Proxmox VE API endpoint
PVE_API_URL=https://192.168.2.11:8006/

# Proxmox VE node name
PVE_NODE=pve-01

# Proxmox API token (format: user@realm!tokenid=secret)
# PVE_API_TOKEN=automation@pam!tofu=your-token-here

# -- Network Configuration ---------------------------------------------------
# Default DNS server IP
DNS_SERVER=192.168.2.1

# MetalLB IP address pool (must be on same VLAN as k3s nodes)
METALLB_IP_RANGE=192.168.2.240-192.168.2.250

# -- iLO Configuration -------------------------------------------------------
# iLO admin password (used by provision-server target)
# ILO_PASS=your-ilo-password

# Proxmox ISO URL (operator must serve ISO on local HTTP server)
# PROXMOX_ISO_URL=http://fileserver.lab.demena.net/proxmox-ve_8.3-1.iso

# -- SSH Configuration -------------------------------------------------------
# SSH public key for cloud-init VM provisioning
# SSH_PUBLIC_KEY=ssh-ed25519 AAAAC3... user@host

# -- OpenTofu Backend --------------------------------------------------------
# MinIO endpoint for OpenTofu S3 state backend
# Override via: tofu init -backend-config="endpoint=https://minio.${INGRESS_DOMAIN}"
# MINIO_ENDPOINT=https://minio.apps.lab.demena.net

# MinIO credentials (also used as AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY)
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
